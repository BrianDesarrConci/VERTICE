# URL del Web App de Google Apps Script (deploy → Web App → "cualquiera").
# Ej: https://script.google.com/macros/s/AKfy.../exec
VITE_GAS_URL=

# Token compartido para endpoints admin del backend (debe coincidir con ADMIN_TOKEN en Code.gs).
VITE_ADMIN_TOKEN=vertice-dev-token

# Si es "true", la app usa datos mock locales aunque VITE_GAS_URL esté vacío (útil para desarrollo/preview).
VITE_USE_MOCK=true
