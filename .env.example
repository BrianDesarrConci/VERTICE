# === Conexión al backend (Google Apps Script) ===
# Pega aquí la URL del Web App publicado (termina en /exec).
# Con esto la tienda queda conectada al backend real (no demo).
VITE_GAS_URL=

# Token compartido para endpoints admin. Debe coincidir con ADMIN_TOKEN en gas/Code.gs.
VITE_ADMIN_TOKEN=vertice-dev-token

# "true" fuerza datos demo aunque haya URL. Déjalo vacío o "false" para usar el backend real.
VITE_USE_MOCK=
